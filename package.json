{
  "name": "xspace",
  "version": "5.1.0",
  "description": "MacBook storage cleaner with a beautiful UI",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"npm run electron-dev\"",
    "electron-dev": "wait-on tcp:5173 && tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:electron": "npm run build && cross-env MAC_BUILD_SIGNED=1 electron-builder --config electron-builder.config.cjs",
    "build:electron:release": "node scripts/check-release-env.cjs && npm run build:electron",
    "build:electron:unsigned": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.cjs",
    "preview": "vite preview",
    "website:setup": "bash scripts/create-download-website.sh",
    "website:dev": "cd website && npm run dev",
    "website:build": "cd website && npm run build",
    "website:start": "cd website && npm run start",
    "test:scanners": "tsc -p tsconfig.node.json && node scripts/check-scanners.mjs",
    "test:palette": "node scripts/check-palette.mjs",
    "test:cache": "node scripts/check-scan-cache.mjs"
  },
  "keywords": [],
  "author": "xSpace",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.1",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "trash": "^8.1.1"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.4",
    "wait-on": "^7.2.0"
  }
}
